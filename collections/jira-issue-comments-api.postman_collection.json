          "name": "Jira Get Comments",
          "request": {
            "name": "Jira Get Comments",
            "description": {
              "content": "Returns all comments for an issue. Comments are ordered by created date in ascending order by default.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "issue",
                ":issueIdOrKey",
                "comment"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startAt",
                  "value": "0",
                  "description": "The index of the first item to return in a page of results (page offset)."
                },
                {
                  "disabled": false,
                  "key": "maxResults",
                  "value": "50",
                  "description": "The maximum number of items to return per page."
                },
                {
                  "disabled": false,
                  "key": "orderBy",
                  "value": "<string>",
                  "description": "The order of comments returned. Accepted values: created (ascending by default), -created (descending)."
                },
                {
                  "disabled": false,
                  "key": "expand",
                  "value": "<string>",
                  "description": "Use expand to include additional information about comments in the response. Accepted values: renderedBody."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "issueIdOrKey",
                  "description": "(Required) The ID or key of the issue (e.g., 10001 or PROJ-123)."
                },
                {
                  "description": "Your Jira Cloud site subdomain (e.g., your-company).",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
