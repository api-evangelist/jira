          "id": "de77c65c-4689-4a7e-82b9-925d7725010d",
          "name": "Jira Get All Statuses for Project",
          "request": {
            "name": "Jira Get All Statuses for Project",
            "description": {
              "content": "Returns the valid statuses for a project. The statuses are grouped by issue type, listing the allowed statuses for each issue type in the project.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "project",
                ":projectIdOrKey",
                "statuses"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "projectIdOrKey",
                  "description": "(Required) The ID or key of the project (e.g., 10000 or PROJ)."
                },
                {
                  "description": "Your Jira Cloud site subdomain (e.g., your-company).",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
