        {
          "id": "56b7dd26-1eef-46b9-b986-81a38fcd9dce",
          "name": "Jira Transition Issue",
          "request": {
            "name": "Jira Transition Issue",
            "description": {
              "content": "Performs an issue transition and, optionally, updates the fields and adds a comment. The fields that can be set depend on the transition and the connected Jira instance configuration.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "issue",
                ":issueIdOrKey",
                "transitions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "issueIdOrKey",
                  "description": "(Required) The ID or key of the issue (e.g., 10001 or PROJ-123)."
                },
                {
                  "description": "Your Jira Cloud site subdomain (e.g., your-company).",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
