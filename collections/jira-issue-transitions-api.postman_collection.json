            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transition\": {\n    \"id\": \"<string>\"\n  },\n  \"fields\": {\n    \"key_0\": 6798,\n    \"key_1\": \"string\",\n    \"key_2\": true\n  },\n  \"update\": {\n    \"key_0\": [\n      {\n        \"add\": {},\n        \"remove\": {},\n        \"set\": {},\n        \"edit\": {},\n        \"copy\": {}\n      },\n      {\n        \"add\": {},\n        \"remove\": {},\n        \"set\": {},\n        \"edit\": {},\n        \"copy\": {}\n      }\n    ],\n    \"key_1\": [\n      {\n        \"add\": {},\n        \"remove\": {},\n        \"set\": {},\n        \"edit\": {},\n        \"copy\": {}\n      },\n      {\n        \"add\": {},\n        \"remove\": {},\n        \"set\": {},\n        \"edit\": {},\n        \"copy\": {}\n      }\n    ]\n  },\n  \"historyMetadata\": {\n    \"key_0\": 4816.814016491301,\n    \"key_1\": 9989.250474692142,\n    \"key_2\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
