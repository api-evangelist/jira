  "item": [
    {
      "id": "9e397746-66a2-48d3-8579-0dc0b2515ef5",
      "name": "Issue Search",
      "description": {
        "content": "Search for issues using JQL (Jira Query Language).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8724f9b5-41a0-40a0-a63d-d7e663d68127",
          "name": "Jira Search for Issues Using Jql (get)",
          "request": {
            "name": "Jira Search for Issues Using Jql (get)",
            "description": {
              "content": "Searches for issues using JQL. If the JQL query expression is too large to be encoded as a query parameter, use the POST version of this resource. Sorting is supported via the ORDER BY clause in JQL.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "jql",
                  "value": "<string>",
                  "description": "The JQL query string. For example: project = HSP AND issuetype = Bug. See JQL documentation for syntax."
                },
                {
                  "disabled": false,
                  "key": "startAt",
                  "value": "0",
                  "description": "The index of the first item to return in a page of results (page offset)."
                },
                {
                  "disabled": false,
                  "key": "maxResults",
                  "value": "50",
                  "description": "The maximum number of items to return per page. The maximum allowed value is determined by the Jira instance configuration, typically 100."
                },
                {
                  "disabled": false,
                  "key": "validateQuery",
                  "value": "strict",
                  "description": "Whether to validate the JQL query and how to handle validation results. Accepted values: strict, warn, none."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "A list of fields to return for each issue. Use *all for all fields, *navigable for navigable fields only."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "A list of fields to return for each issue. Use *all for all fields, *navigable for navigable fields only."
                },
                {
                  "disabled": false,
                  "key": "expand",
                  "value": "<string>",
                  "description": "Use expand to include additional information about issues in the response. Accepted values: renderedFields, names, schema, transitions, operations, editmeta, changelog, versionedRepresentations."
                },
                {
                  "disabled": false,
                  "key": "properties",
                  "value": "<string>",
                  "description": "A list of issue properties to return for each issue."
                },
                {
                  "disabled": false,
                  "key": "properties",
                  "value": "<string>",
                  "description": "A list of issue properties to return for each issue."
                },
                {
                  "disabled": false,
                  "key": "fieldsByKeys",
                  "value": "false",
                  "description": "Whether fields in fields are referenced by keys rather than IDs."
                }
              ],
              "variable": [
                {
                  "description": "Your Jira Cloud site subdomain (e.g., your-company).",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
